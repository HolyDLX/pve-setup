auto {{VM_BRIDGE}}
iface {{VM_BRIDGE}} inet static
    address {{VM_GATEWAY}}/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0

    post-up echo 1 > /proc/sys/net/ipv4/ip_forward

    post-up iptables -t nat -A POSTROUTING -s '{{VM_NETWORK}}' -o {{UPLINK_INTERFACE}} -j MASQUERADE
    post-down iptables -t nat -D POSTROUTING -s '{{VM_NETWORK}}' -o {{UPLINK_INTERFACE}} -j MASQUERADE
