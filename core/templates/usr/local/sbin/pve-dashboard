#!/bin/bash

printf 'starting up...\n'

UPLINK_INTERFACE="{{UPLINK_INTERFACE}}"
TTYMONITOR_DIR="/etc/pve-setup/ttymonitor.d"

while true; do
    HOST_IP=$(
        ip -4 addr show "$UPLINK_INTERFACE" 2>/dev/null \
            | awk '/inet / {print $2}' \
            | cut -d/ -f1
    )

    MEMORY=$(
        free -h \
            | awk 'NR==2 {printf "%s used / %s total", $3, $2}'
    )

    DISK=$(
        df -h / \
            | awk 'NR==2 {printf "%s used / %s total (%s)", $3, $2, $5}'
    )

    CONTAINERS=$(
        pct list \
            | awk 'NR > 1 {
                printf "  %-6s %-20s %-10s\n", $1, $3, $2
            }'
    )

    INTERFACE_STATE=$(
        cat "/sys/class/net/$UPLINK_INTERFACE/operstate" 2>/dev/null \
            || echo "unknown"
    )

    NETWORK_TYPE="Ethernet"
    SSID=""

    if [[ -d "/sys/class/net/$UPLINK_INTERFACE/wireless" ]]; then
        NETWORK_TYPE="Wi-Fi"

        if command -v iw >/dev/null 2>&1; then
            SSID=$(
                iw dev "$UPLINK_INTERFACE" link 2>/dev/null \
                    | sed -n 's/^[[:space:]]*SSID: //p'
            )
        fi

        if [[ -z "$SSID" ]]; then
            SSID="Not connected"
        fi
    fi

    NETWORK_DETAILS=$(cat <<EOF
Interface: $UPLINK_INTERFACE
Type:      $NETWORK_TYPE
State:     $INTERFACE_STATE
IP:        ${HOST_IP:-N/A}
EOF
)

    if [[ "$NETWORK_TYPE" == "Wi-Fi" ]]; then
        NETWORK_DETAILS+=$'\n'"SSID:      $SSID"
    fi

    SERVICES=""

    if [[ -d "$TTYMONITOR_DIR" ]]; then
        for MONITOR in "$TTYMONITOR_DIR"/*; do
            [[ -f "$MONITOR" && -x "$MONITOR" ]] || continue

            MONITOR_OUTPUT=$(
                timeout 3 "$MONITOR" 2>/dev/null || true
            )

            if [[ -n "$MONITOR_OUTPUT" ]]; then
                while IFS= read -r line; do
                    [[ -n "$line" ]] || continue
                    SERVICES+="  $line"$'\n'
                done <<< "$MONITOR_OUTPUT"
            fi
        done
    fi

    if [[ -z "$SERVICES" ]]; then
        SERVICES="  No service monitors installed"$'\n'
    fi

    OUTPUT=$(cat <<EOF
============================================================
                 Proxmox Virtual Environment
============================================================

Host:      $(hostname)
Web UI:    https://${HOST_IP:-N/A}:8006/

Network:
$NETWORK_DETAILS

Memory:
  $MEMORY

Disk:
  $DISK

LXC Containers:
  ID     NAME                 STATUS
$CONTAINERS

Services:
${SERVICES%$'\n'}

Updated: $(date)

Login console: Ctrl+Alt+F2
EOF
)

    printf '\033[H\033[J%s\n' "$OUTPUT"
    sleep 10
done
